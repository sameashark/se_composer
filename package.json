  },
  "devDependencies": {
    "@types/node": "^26.4.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "node-web-audio-api": "^1.0.9",
    "typescript": "^5.6.3",
    "vite": "^6.0.7"
  }
}
